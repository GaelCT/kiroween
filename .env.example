# Copy this file to .env.local and fill it in. .env.local is gitignored: never commit a key.

# Which AI provider runs fact extraction: anthropic or openai.
AI_PROVIDER=

# A model ID from your provider's model list.
AI_MODEL=

# The key for the provider you chose. You only need one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: how many articles one visitor can send for live comparison per day. Defaults to 60.
# LIVE_ARTICLE_LIMIT=60
