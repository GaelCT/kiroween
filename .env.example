# Copy this file to .env.local and fill it in. .env.local is gitignored: never commit a key.

# Which AI provider runs fact extraction. The team uses openrouter; anthropic and openai also work.
AI_PROVIDER=openrouter

# A model ID from your provider's model list. On OpenRouter it looks like vendor/model:
# pick one from https://openrouter.ai/models. Models that reason before answering can use up the
# token limit and return nothing, so prefer one without reasoning, or with reasoning off.
AI_MODEL=

# The key for the provider you chose. You only need one.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: how many articles one visitor can send for live comparison per day. Defaults to 60.
# LIVE_ARTICLE_LIMIT=60
